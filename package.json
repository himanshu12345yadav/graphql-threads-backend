{
  "name": "graphql-threads-backend",
  "version": "1.0.0",
  "description": "This is a graphql apollo server backend",
  "main": "index.ts",
  "scripts": {
    "start": "node .build/server.js",
    "dev": "nodemon index.ts",
    "build": "esbuild index.ts --platform=node --bundle --format=cjs --minify --outfile=.build/server.js",
    "test": "npm run test",
    "lint": "eslint ./ --ext .js,.ts",
    "lint:fix": "eslint --fix ./ --ext .js,.ts"
  },
  "keywords": [
    "graphql",
    "threads",
    "postgres",
    "docker"
  ],
  "author": "Himanshu Yadav",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.9.1",
    "@graphql-tools/schema": "^10.0.0",
    "@prisma/client": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.7.1",
    "prisma": "^5.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.8",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "esbuild": "^0.18.17",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.0.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
}
